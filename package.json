{
  "name": "codexia",
  "version": "1.4.0",
  "type": "module",
  "description": "Windows desktop app for Codex subscription accounts, model channels, API access, and MCP service management.",
  "license": "MIT",
  "author": "jadchene",
  "keywords": [
    "codex",
    "gateway",
    "electron",
    "local-first",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadchene/codexia.git"
  },
  "homepage": "https://github.com/jadchene/codexia#readme",
  "bugs": {
    "url": "https://github.com/jadchene/codexia/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build:main": "tsup --config tsup.main.config.ts && node scripts/check-main-bundle.mjs",
    "build:preload": "tsup --config tsup.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "pack:unpacked": "npm run build && node scripts/pack-unpacked.mjs",
    "smoke:unpacked": "node scripts/smoke-unpacked.mjs",
    "smoke:unpacked:upgrade": "node scripts/prepare-unpacked-legacy-fixture.mjs && node scripts/smoke-unpacked.mjs --expect-legacy-upgrade",
    "check": "node scripts/check-source.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@tanstack/react-query": "5.101.4",
    "antd": "6.5.3",
    "dayjs": "1.11.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "happy-dom": "20.11.1",
    "rcedit": "5.0.2",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
